{
  "name": "tokenfall",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch server/index.ts",
    "start": "node server/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm --prefix web run build",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
